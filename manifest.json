{
  "manifest_version": 3,
  "name": "SplitSmart AI - Serverless Receipt Splitter",
  "short_name": "SplitSmart AI",
  "version": "1.0.0",
  "description": "Serverless AI receipt scanner & voice-driven expense splitter for Meta Global AI Hackathon. Powered by Meta Model API (Muse Spark 1.3) & Splitwise.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.meta.ai/*",
    "https://secure.splitwise.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SplitSmart AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

